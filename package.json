{
  "name": "hyperquant-3d-desk",
  "private": true,
  "version": "2.4.0",
  "description": "Open-source BTC day-trading desk for Hyperliquid: pre-session, in-session and post-session screens, live order-flow heatmap & footprint, verifiable forecast ledger, cross-market context, PWA.",
  "license": "MIT",
  "homepage": "https://hyperquant.tech/",
  "repository": {
    "type": "git",
    "url": "https://github.com/rdemb/HyperQuant.git"
  },
  "type": "module",
  "workspaces": [
    "mcp"
  ],
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "vite build && node scripts/blog/build.mjs",
    "blog:check": "node scripts/blog/build.mjs --check",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "data": "node scripts/fetch-public-data.mjs",
    "mcp:build": "vite build --config mcp/vite.config.ts",
    "mcp:mcpb": "node scripts/mcp/bundle-mcpb.mjs",
    "ui:check": "vite build && node scripts/ui/layout-check.mjs --serve --strict",
    "ui:check:live": "vite build && node scripts/ui/layout-check.mjs --serve --live"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3": "^7.4.3",
    "@vitejs/plugin-react": "^6.1.1",
    "d3": "^7.9.0",
    "express": "^5.3.0",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.59.0",
    "motion": "^14.3.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tsx": "^4.21.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "marked": "^18.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
