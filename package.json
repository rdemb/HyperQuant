{
  "name": "hyperquant",
  "private": true,
  "version": "2.4.0",
  "description": "Open-source order-flow desk for Hyperliquid: footprint, order-book heatmap, delta and CVD, liquidation maps and a verifiable forecast ledger for BTC, gold and the S&P 500. Installable PWA.",
  "license": "MIT",
  "homepage": "https://hyperquant.tech/",
  "repository": {
    "type": "git",
    "url": "https://github.com/rdemb/HyperQuant.git"
  },
  "type": "module",
  "workspaces": [
    "mcp"
  ],
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "vite build && node scripts/blog/build.mjs",
    "blog:check": "node scripts/blog/build.mjs --check",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "data": "node scripts/fetch-public-data.mjs",
    "mcp:build": "vite build --config mcp/vite.config.ts",
    "mcp:mcpb": "node scripts/mcp/bundle-mcpb.mjs",
    "ui:check": "node scripts/ui/build.mjs && node scripts/ui/layout-check.mjs --serve --strict",
    "ui:check:live": "vite build && node scripts/ui/layout-check.mjs --serve --live",
    "icons": "node scripts/icons/ikona.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/d3": "^7.4.3",
    "@vitejs/plugin-react": "^6.3.0",
    "d3": "^7.9.2",
    "express": "^5.3.0",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.70.0",
    "motion": "^14.10.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tsx": "^4.21.0",
    "vite": "^8.3.6"
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "marked": "^18.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  }
}
