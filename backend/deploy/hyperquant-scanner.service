[Unit]
Description=HyperQuant — skaner pozycji Hyperliquid (mapa likwidacji)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hyperquant
Group=hyperquant
WorkingDirectory=/opt/hyperquant/app
EnvironmentFile=/etc/hyperquant/scanner.env
ExecStart=/opt/hyperquant/node/bin/node backend/scanner/main.ts
Restart=always
RestartSec=10

# Skaner dzieli serwer z innymi usługami — niski priorytet i twarde limity zasobów
Nice=10
CPUQuota=50%
MemoryMax=512M

# Izolacja: zapis tylko do katalogu stanu, bez uprawnień i dostępu do katalogów domowych
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
SystemCallArchitectures=native
ReadWritePaths=/var/lib/hyperquant

[Install]
WantedBy=multi-user.target
