# Szablon konfiguracji skanera. Prawdziwy plik: /etc/hyperquant/scanner.env na serwerze (root:hyperquant, 0640).
# Nie commituj prawdziwych wartości.

HQ_COIN=BTC
# Budżet wag API Hyperliquid na minutę (limit giełdy 1200/min na IP; zostaw zapas dla innych usług na tym serwerze)
HQ_WEIGHT_PER_MIN=240
HQ_STATE_DIR=/var/lib/hyperquant/state
HQ_OUT_DIR=/var/lib/hyperquant/out
HQ_PUBLISH_EVERY_S=60
HQ_MAX_ADDRESSES=50000
# Zasiew największymi kontami z publicznego rankingu Hyperliquid co 6 h (0 = wyłączone)
HQ_SEED_TOP=5000
HQ_SEED_MIN_USD=100000

# Publiczne repo danych na GitHubie (darmowe; zalecane): klucz wdrożeniowy z prawem zapisu tylko do tego repo
HQ_GIT_REMOTE=
HQ_GIT_SSH_KEY=
HQ_GIT_EVERY_S=120

# Rejestrator historii taśmy i arkusza (gałąź `history` repo danych): rynki po przecinku, puste = wyłączony; okno w dniach
HQ_HISTORY_MARKETS=
HQ_HISTORY_DAYS=7
# Warstwa wielorybów: ile największych kont z rankingu śledzić (0 = wyłączona) i jej budżet wag (razem z HQ_WEIGHT_PER_MIN ≤ 800)
HQ_WHALE_TOP=0
HQ_WHALE_WEIGHT_PER_MIN=200

# Cloudflare R2 (opcjonalnie) — wszystkie cztery albo żadna (bez nich skaner zapisuje tylko lokalnie do HQ_OUT_DIR)
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
