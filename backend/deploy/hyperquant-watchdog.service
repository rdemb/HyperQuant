[Unit]
Description=HyperQuant — strażnik skanera (samonaprawa i alarm w repo danych)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Własny użytkownik systemowy (nie root, nie użytkownik skanera, któremu strażnik nie ufa). Restart tylko skanera
# i serwera powiadomień przez regułę polkit (hyperquant-watchdog.rules). Grupa usług: odczyt status.json skanera
# i pulsu serwera powiadomień (pliki 0640). Kod z kopii, którą install.sh kładzie poza katalogiem aktualizowanym
# co 15 min — push do repo nie zmienia strażnika, tylko ponowny install.sh. Klucz wdrożeniowy repo danych dostaje
# z LoadCredential (drop-in tworzony przez install.sh), więc plik klucza zostaje własnością skanera.
User=hyperquant-watchdog
Group=hyperquant-watchdog
SupplementaryGroups=hyperquant
WorkingDirectory=/opt/hyperquant/watchdog
EnvironmentFile=/etc/hyperquant/scanner.env
# Sekrety R2 z pliku skanera nie są strażnikowi potrzebne
UnsetEnvironment=R2_ACCOUNT_ID R2_BUCKET R2_ACCESS_KEY_ID R2_SECRET_ACCESS_KEY
StateDirectory=hyperquant-watchdog
StateDirectoryMode=0700
Environment=HQ_WATCHDOG_DIR=/var/lib/hyperquant-watchdog
ExecStart=/opt/hyperquant/node/bin/node /opt/hyperquant/watchdog/watchdog.mjs
TimeoutStartSec=5min
Nice=10

# Izolacja jak skaner: bez uprawnień, zapis tylko do własnego katalogu stanu (StateDirectory). Bez ProtectProc —
# systemctl sprawdza /proc/1, a strażnik pyta systemd o stan usług.
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
