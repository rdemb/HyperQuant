[Unit]
Description=HyperQuant — aktualizacja kodu skanera (gałąź zdalna albo podpisane tagi)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# root: zapis do /opt/hyperquant/app i restart usług skanera i powiadomień. Polecenia w pliku, który install.sh
# kopiuje do /opt/hyperquant/bin (wzorzec: backend/deploy/hyperquant-update.sh) — kod z repo nie wykonuje się jako
# root. Tryb podpisanych tagów włącza plik /etc/hyperquant/allowed_signers; opcjonalnie HQ_UPDATE_TAG_GLOB
# w /etc/hyperquant/update.env. Pliki usług systemd i kopię strażnika zmienia wyłącznie install.sh.
WorkingDirectory=/opt/hyperquant/app
EnvironmentFile=-/etc/hyperquant/update.env
ExecStart=/opt/hyperquant/bin/hyperquant-update
TimeoutStartSec=5min
Nice=10

UMask=0022
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/hyperquant/app
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
SystemCallArchitectures=native
