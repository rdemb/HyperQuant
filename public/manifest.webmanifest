      "url": "./#before",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "In session",
      "short_name": "In session",
      "description": "Cockpit: live footprint, DOM column and tapes, cohorts and liquidations",
      "url": "./#charts",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Post-session",
      "short_name": "Post-session",
      "description": "Review: day review, forecast ledger and trade journal",
